# edk2-build.py configuration for SiliconWin's UEFI firmware.
#
# Same feature set as the edk2-aarch64-code.fd shipped with QEMU 11.1
# (roms/edk2-build.config, "armvirt.aa64"), plus the QemuRamfbDxe patch in
# Firmware/src/QemuRamfb.c that adds high-resolution display modes.
#
# Scripts/build-firmware.sh passes the edk2 tree with --core and runs the
# build from $SILICONWIN_BUILD, so relative paths below resolve there.

[opts.common]
NETWORK_HTTP_BOOT_ENABLE = TRUE
NETWORK_IP6_ENABLE       = TRUE
NETWORK_TLS_ENABLE       = TRUE
NETWORK_ISCSI_ENABLE     = TRUE
NETWORK_ALLOW_HTTP_CONNECTIONS = TRUE
TPM2_ENABLE              = TRUE
TPM2_CONFIG_ENABLE       = TRUE
TPM1_ENABLE              = TRUE
CAVIUM_ERRATUM_27456     = TRUE

[opts.armvirt.silent]
DEBUG_PRINT_ERROR_LEVEL  = 0x80000000

[pcds.nx.broken.shim.grub]
PcdDxeNxMemoryProtectionPolicy = 0xC000000000007FD1
PcdUninstallMemAttrProtocol    = TRUE

[pcds.siliconwin]
# ArmVirtQemu runs PEIMs in place from flash, which it maps read-only. Some
# PEIMs pulled in by the TPM stack (e.g. BaseRngLib's constructor) write
# globals and fault there. Shadow PEIMs into RAM once memory is up instead
# (the MdeModulePkg default) so the TPM 2.0 stack works.
PcdShadowPeimOnBoot = TRUE

[build.armvirt.aa64]
desc = SiliconWin ArmVirt build, 64-bit (arm v8), high-resolution ramfb
conf = ArmVirtPkg/ArmVirtQemu.dsc
arch = AARCH64
opts = common
       armvirt.silent
pcds = nx.broken.shim.grub
       siliconwin
plat = ArmVirtQemu-AARCH64
dest = firmware
cpy1 = FV/QEMU_EFI.fd  siliconwin-aarch64-code.fd
