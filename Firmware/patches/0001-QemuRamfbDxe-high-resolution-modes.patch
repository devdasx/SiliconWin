     mQemuRamfbModeInfo[Index].PixelsPerScanLine =
       mQemuRamfbModeInfo[Index].HorizontalResolution;
     mQemuRamfbModeInfo[Index].PixelFormat =
@@ -314,9 +438,9 @@
